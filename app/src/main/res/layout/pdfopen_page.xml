<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".PDFOpen"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF Menüpont!"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="48dp"/>


    <!-- Buttons Section -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onlinePdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="56dp"
            android:paddingVertical="12dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:text="PDF Keresése"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary"
            app:rippleColor="@color/primary_dark"
            app:icon="@drawable/ic_login"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            app:iconPadding="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:layout_constraintWidth_percent="0.8"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickPdfButton"
            app:layout_constraintTop_toBottomOf="@id/onlinePdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:minHeight="56dp"
            android:paddingVertical="12dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:text="Letöltések megnyitása"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary"
            app:rippleColor="@color/primary_dark"
            app:icon="@drawable/ic_login"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            app:iconPadding="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:layout_constraintWidth_percent="0.8"/>


        <!-- PDF Viewer Section -->
        <com.rajat.pdfviewer.PdfRendererView
            android:id="@+id/pdfView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:pdfView_showDivider="true"
            app:pdfView_enableZoom="true"
            app:layout_constraintTop_toBottomOf="@id/onlinePdf"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

