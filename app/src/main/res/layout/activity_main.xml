<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Top Bar Layout for Navigation & Config & Logout -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/menubutton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:onClick="menuPoint"
                android:src="@drawable/hamburgerwhite"
                android:contentDescription="Menü" />

            <Button
                android:id="@+id/load_config_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:onClick="selectConfigFromJsonFile"
                android:text="Konfiguráció kiválasztása"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:singleLine="true"
                android:ellipsize="end"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/primary"
                app:rippleColor="@color/primary_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="logoutUser"
                android:text="Kijelentkezés"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/primary"
                app:rippleColor="@color/primary_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <TextView
                android:id="@+id/userBadgeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Bejelentkezve: Kovács Péter (Műszakvezető)"
                android:textColor="#E0E0E0"
                android:textSize="16sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:text="Üdvözlünk!"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/belepes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:letterSpacing="0"
                android:minHeight="56dp"
                android:onClick="loggingIn"
                android:paddingVertical="12dp"
                android:text="Cérna keresése"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconTint="@android:color/white"
                app:rippleColor="@color/primary_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pdfek"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:letterSpacing="0"
                android:minHeight="56dp"
                android:onClick="pdfOpen"
                android:paddingVertical="12dp"
                android:text="PDF-ek megtekintése"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconTint="@android:color/white"
                app:rippleColor="@color/primary_dark" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
